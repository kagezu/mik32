#pragma once
#include "eeprom.h"
// #include "ee-head.h"

#define EE_PAGE_M   0x1F

u32 ee_write(void *data, u32 addr, u32 length)
{
  u32 *src = (u32 *)data;
  length = (length + 1) >> 2;
  addr &= ~3;

  while (length && addr < EEPROM_EEA_ADDR_M) {  // Пока не закончатся данные или память
    EEPROM_REGS->EECON = EEPROM_EECON_BWE_M;    // Разрешение записи в буфер с ожиданием шины
    EEPROM_REGS->EEA = addr;                    // Адрес начала записи

    do {
      EEPROM_REGS->EEDAT = -1;
      addr += 4;
      length--;
    } while (length && addr & (EE_PAGE_M << EE_WORD));   // Конец данных или буфера

    EEPROM_REGS->EECON |=
      EEPROM_EECON_OP(EEPROM_EECON_OP_PR) |           // Операция программирования
      EEPROM_EECON_EX_M;                              // Запустить процесс
    while (EEPROM_REGS->EESTA & EEPROM_EESTA_BSY_M);  // Ожидать завершения
  }
  return addr;
}


void ee_erase(u32 addr, u32 length)
{
  length = (length + 1) >> 2;

  while (length && addr < EEPROM_EEA_ADDR_M) {  // Пока не закончатся данные или память
    EEPROM_REGS->EECON = EEPROM_EECON_BWE_M;    // Разрешение записи в буфер с ожиданием шины
    EEPROM_REGS->EEA = addr;                    // Адрес начала записи

    do {
      EEPROM_REGS->EEDAT = -1;
      addr += 4;
      length--;
    } while (length && addr & (EE_PAGE_M << EE_WORD));   // Конец данных или буфера

    EEPROM_REGS->EECON |=
      EEPROM_EECON_OP(EEPROM_EECON_OP_ER) |           // Операция стирания
      EEPROM_EECON_EX_M;                              // Запустить процесс
    while (EEPROM_REGS->EESTA & EEPROM_EESTA_BSY_M);  // Ожидать завершения
  }
}

//////// EE RAW

void ee_write(void *data, EE_Head head)
{
  u32 *src = (u32 *)data;
  u32 length = head.raw_length();
  u32 addr = head.raw_addr();

  while (length && addr < EE_2K_M) {  // Пока не закончатся данные или память
    EEPROM_REGS->EECON = EEPROM_EECON_BWE_M;  // Разрешение записи в буфер с ожиданием шины
    EEPROM_REGS->EEA = addr << EE_WORD;       // Адрес начала записи

    do {
      EEPROM_REGS->EEDAT = *src++;
      addr++;
      length--;
    } while (length && addr & EE_PAGE_M);   // Конец данных или буфера

    EEPROM_REGS->EECON |=
      EEPROM_EECON_OP(EEPROM_EECON_OP_PR) |           // Операция программирования
      EEPROM_EECON_EX_M;                              // Запустить процесс
    while (EEPROM_REGS->EESTA & EEPROM_EESTA_BSY_M);  // Ожидать завершения
  }
}

void ee_erase(EE_Head head)
{
  u32 length = head.raw_length();
  u32 addr = head.raw_addr();

  while (length && addr < EE_2K_M) {  // Пока не закончатся данные или память
    EEPROM_REGS->EECON = EEPROM_EECON_BWE_M;  // Разрешение записи в буфер с ожиданием шины
    EEPROM_REGS->EEA = addr << EE_WORD;       // Адрес начала записи

    do {
      EEPROM_REGS->EEDAT = -1;
      addr++;
      length--;
    } while (length && addr & EE_PAGE_M);   // Конец данных или буфера

    EEPROM_REGS->EECON |=
      EEPROM_EECON_OP(EEPROM_EECON_OP_PR) |           // Операция стирания
      EEPROM_EECON_EX_M;                              // Запустить процесс
    while (EEPROM_REGS->EESTA & EEPROM_EESTA_BSY_M);  // Ожидать завершения
  }
}
